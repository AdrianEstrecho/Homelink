VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Full URL of the deployed backend API, e.g. https://homelink-backend.onrender.com/api
# Leave unset for local dev (Vite proxies /api to the backend on localhost:5000)
VITE_API_URL=
# PayMongo public (test mode) key — safe to expose in the browser bundle by design
VITE_PAYMONGO_PUBLIC_KEY=pk_test_your-paymongo-public-key
