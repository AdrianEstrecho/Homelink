VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.yourcompany.web
VITE_APPLE_REDIRECT_URI=https://yourdomain.com/login
# Full URL of the deployed backend API, e.g. https://homelink-backend.onrender.com/api
# Leave unset for local dev (Vite proxies /api to the backend on localhost:5000)
VITE_API_URL=
