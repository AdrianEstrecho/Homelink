PORT=5000
# Supabase Postgres connection string — Project Settings > Database > Connection string. Use
# the pooled ("pooler") host/port 5432 (session mode) for this long-running server.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
JWT_SECRET=homelink-super-secret-key-change-in-production
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
COMPANY_LAT=14.5995
COMPANY_LNG=120.9842
COMPANY_ADDRESS=123 HomeLink Avenue, Metro Manila, Philippines
# Gmail SMTP — needs 2-Step Verification enabled on the account, then an App Password from
# Google Account > Security > 2-Step Verification > App Passwords (the regular account
# password will NOT work). NOTE: this is raw SMTP — several hosts (Render's free tier
# included) block outbound SMTP ports, which would silently break delivery in production.
SMTP_USER=your-account@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM=HomeLink <your-account@gmail.com>
# PayMongo (test mode) — https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY=sk_test_your-paymongo-secret-key
# Issued when you register a webhook endpoint (Dashboard > Developers > Webhooks) pointing
# at POST /api/payments/webhook — needed to verify that webhook deliveries really came from PayMongo.
PAYMONGO_WEBHOOK_SECRET=whsk_your-paymongo-webhook-secret
