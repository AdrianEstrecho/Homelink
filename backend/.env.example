PORT=5000
# Supabase Postgres connection string — Project Settings > Database > Connection string. Use
# the pooled ("pooler") host/port 5432 (session mode) for this long-running server.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
JWT_SECRET=homelink-super-secret-key-change-in-production
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
COMPANY_LAT=14.5995
COMPANY_LNG=120.9842
COMPANY_ADDRESS=123 HomeLink Avenue, Metro Manila, Philippines
# Resend — https://resend.com/api-keys. Free tier needs no domain, no card, no phone. Until
# you verify a domain in the Resend dashboard, EMAIL_FROM must stay exactly as below (their
# shared sandbox sender) and delivery is limited to the address you signed up with — that's
# an anti-abuse sandbox limit, not a bug. Uses the HTTP API, so unlike SMTP it isn't blocked
# on hosts (Render included) that block outbound SMTP ports.
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=HomeLink <onboarding@resend.dev>
# PayMongo (test mode) — https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY=sk_test_your-paymongo-secret-key
# Issued when you register a webhook endpoint (Dashboard > Developers > Webhooks) pointing
# at POST /api/payments/webhook — needed to verify that webhook deliveries really came from PayMongo.
PAYMONGO_WEBHOOK_SECRET=whsk_your-paymongo-webhook-secret
