PORT=5000
# Supabase Postgres connection string — Project Settings > Database > Connection string > URI
# (use the "Session pooler" option for a long-running server like this one).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-region.pooler.supabase.com:5432/postgres
JWT_SECRET=homelink-super-secret-key-change-in-production
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
COMPANY_LAT=14.5995
COMPANY_LNG=120.9842
COMPANY_ADDRESS=123 HomeLink Avenue, Metro Manila, Philippines
# Resend (https://resend.com) — used over HTTPS instead of raw SMTP so email still works on
# hosts that block outbound SMTP ports. Dashboard > API Keys. Without a verified sending
# domain (Dashboard > Domains), delivery is limited to the email the Resend account signed up with.
RESEND_API_KEY=re_your-resend-api-key
# EMAIL_FROM=HomeLink <onboarding@resend.dev>
# PayMongo (test mode) — https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY=sk_test_your-paymongo-secret-key
# Issued when you register a webhook endpoint (Dashboard > Developers > Webhooks) pointing
# at POST /api/payments/webhook — needed to verify that webhook deliveries really came from PayMongo.
PAYMONGO_WEBHOOK_SECRET=whsk_your-paymongo-webhook-secret
